---
import { Code } from 'astro:components';
import type { ComponentProps } from 'astro/types';
import { kahramanTheme } from '../kahraman-theme.ts';

interface Props {
  code: string;
  lang?: ComponentProps<typeof Code>['lang'];
}
const { code, lang = 'ts' } = Astro.props;
---
<Code code={code.trim()} lang={lang} theme={kahramanTheme} class="code" />
